{
  "name": "scribe-extension",
  "private": true,
  "version": "0.3.0",
  "description": "Chrome MV3 companion for the Cliniko clinical scribe (Phase 1: security foundation)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
