  "axes": ["numbers", "small_talk", "end_and_new_patient"],
  "lines": [
    {"role": "clinician", "text": "Hello, come on in. How's the shoulder six weeks after the repair?"},
    {"role": "patient", "text": "Sore at night still, but the sling's off as of Monday."},
    {"role": "clinician", "text": "Are you still on the painkillers from the hospital?"},
    {"role": "patient", "text": "Just the odd one."},
    {"role": "clinician", "text": "Your letter from the hospital says tramadol 50 milligrams up to four times a day, only at night if you can manage it."},
    {"role": "clinician", "text": "Let me have a look at how far it goes up."},
    {"role": "clinician", "text": "With me lifting it, the arm goes up to about 120 degrees, and you're not to lift it yourself yet."},
    {"role": "clinician", "text": "Lean on the kitchen worktop and let the arm hang and swing in small circles, a minute each way, three times a day."},
    {"role": "clinician", "text": "You can sleep on your back propped up, with a pillow tucked under that elbow."},
    {"role": "patient", "text": "Lovely. Oh, how did your boy get on with his driving test?"},
    {"role": "clinician", "text": "Passed first time, would you believe. Right, see you in a fortnight."},
    {"role": "patient", "text": "Bye now."},
    {"role": "clinician", "text": "Morning, Mrs Hughes, come and sit down. Been busy at the allotment?"},
    {"role": "next_patient", "text": "Not as busy as I'd like, my right knee's been swelling up every time I kneel."},
    {"role": "clinician", "text": "Oh no, let's get your shoe off then."}
  ],
