  "lines": [
    {"role": "clinician", "text": "Hi Tom, sit down. What are you coming in with?"},
    {"role": "patient", "text": "Stiff neck and headaches since I started the new job, I'm hunched over a laptop on the sofa."},
    {"role": "clinician", "text": "Where do the headaches sit?"},
    {"role": "patient", "text": "Behind my left eye, and they build through the afternoon."},
    {"role": "clinician", "text": "Any numbness or tingling in the arms, or dizziness?"},
    {"role": "patient", "text": "None at all."},
    {"role": "clinician", "text": "Let me have a look at your posture and your neck movement."},
    {"role": "clinician", "text": "Your chin pokes forward and turning left reproduces the headache."},
    {"role": "clinician", "text": "Scribe, leave the bit about his job out of the note."},
    {"role": "clinician", "text": "Get the laptop on a table with a proper chair, and every hour tuck your chin in and hold for five seconds, five times."},
    {"role": "clinician", "text": "Book in for two weeks and we'll see how the headaches respond."}
  ],
