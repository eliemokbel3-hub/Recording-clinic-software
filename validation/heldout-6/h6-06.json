  "lines": [
    {"role": "clinician", "text": "Now then, how's that shoulder doing?"},
    {"role": "patient", "text": "Much better since last time, I can reach the top cupboard again."},
    {"role": "clinician", "text": "Grand. Lift your arm up sideways for me."},
    {"role": "clinician", "text": "You're getting to about 150 degrees now without that catch at the top."},
    {"role": "clinician", "text": "We'll add a resistance band, so pull it out to the side with your elbow tucked in, three sets of 12, every other day."},
    {"role": "patient", "text": "Will do. It still aches if I lie on it at night, mind."},
    {"role": "clinician", "text": "That'll be the last thing to settle. Right, ta-ra then, love, see you in a fortnight."},
    {"role": "patient", "text": "Ta-ra, thanks pet."},
    {"role": "clinician", "text": "Ey up, Derek, come in, sit yourself down. Did you watch the match?"},
