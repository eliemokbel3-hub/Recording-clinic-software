  "lines": [
    {"role": "clinician", "text": "Good morning. So it's four weeks since the knee replacement, is that right?"},
    {"role": "patient", "text": "Five weeks on Friday."},
    {"role": "clinician", "text": "How has it been from last time?"},
    {"role": "patient", "text": "The morning stiffness is the worst bit, it takes a good hour to ease off."},
    {"role": "patient", "text": "And I've had some tingling around the scar, on the outer side."},
    {"role": "patient", "text": "Mind you, I couldn't swear to that."},
    {"role": "clinician", "text": "Let me have a look at the bend. Lie back for me."},
    {"role": "clinician", "text": "Bend is 95 degrees and it straightens to within 5 degrees of flat."},
    {"role": "patient", "text": "I'm taking the codeine 30 milligrams four times a day."},
    {"role": "patient", "text": "Um, three times a day, I mean. I cut one out last week."},
    {"role": "clinician", "text": "That's fine. Keep icing for 15 minutes after each walk, and swap to the single crutch in the house from tomorrow."},
    {"role": "clinician", "text": "If the calf goes hot, red or swollen, ring the ward the same day."},
    {"role": "clinician", "text": "See you next week."},
    {"role": "patient", "text": "Thanks, see you then."}
  ],
