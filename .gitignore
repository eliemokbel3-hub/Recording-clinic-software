# Local environment — never commit real values
.env

# Machine-specific / per-developer notes (never secrets)
AGENTS.local.md
CLAUDE.local.md
.claude/settings.local.json

# Transient /execute-loop run logs (rest of .cursor/ stays committed)
.cursor/loops/

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Installation plan Task 3.3: the staged release models
# (scripts/setup-models.py --root build/models) and other local build output
/build/

# Node / extension build
node_modules/
extension/dist/
extension/dist-dev/

# Extension signing key — never commit (see plan Critical Constraints)
key.pem
# The dev-channel key (installation plan Task 1.3); the bare name above does
# not match it
extension/key-dev.pem

# Pilot plan Constraint 8 / decision 3.6 (review round 22): no recording or
# validation-set build output ever enters the repository, wherever a set
# folder is made (the builder refuses one inside it; the runner only reads)
*.wav
*.built

# Machine-generated native-host registration artifacts (pre-gate locations;
# registration now installs into the channel's data folder under %LOCALAPPDATA% —
# ClinikoScribe, or ClinikoScribe-dev from a source checkout — outside the repo)
scripts/com.scribe.cliniko_host.json
scripts/dev-host-launcher.bat
